# ==============================================================================
# TAS - Solução de Automação de Testes (Cidade Conectada)
# Modelo de Variáveis de Ambiente (.env.example)
#
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente local:
#   cp .env.example .env
# ==============================================================================

# Ambiente de execução
NODE_ENV=test

# Endereço base da API do SUT (Sistema Sob Teste)
API_BASE_URL=http://localhost:3000/api/v1

# Porta do servidor SUT didático local
SUT_PORT=3000

# Credenciais de teste - Perfil Cidadão (semeado no SUT didático)
CITIZEN_EMAIL=ana@exemplo.com
CITIZEN_PASSWORD=senha123

# Credenciais de teste - Perfil Gestor (semeado no SUT didático)
MANAGER_EMAIL=gestor@exemplo.com
MANAGER_PASSWORD=senha123
